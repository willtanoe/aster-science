# Copy to env.local.sh (gitignored) for a manual setup; install.sh writes it
# for you. Values are exported into the launcher and the proxy.
export ASTER_OPENAI_BASE_URL='https://api.openai.com/v1'
export ASTER_OPENAI_API_KEY='sk-...'
export ASTER_OPENAI_MODEL='gpt-4o'
# Optional: alias -> model, or alias -> {model, base_url?, api_key?}
# export ASTER_MODEL_MAP='{"claude-opus-5":"gpt-4o","claude-sonnet-4-6":"gpt-4o-mini"}'
