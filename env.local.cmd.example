@echo off
rem Copy this file to env.local.cmd and fill in your values.
rem env.local.cmd is gitignored; never commit real credentials.
rem Loaded by aster-science.cmd and proxy\run-proxy.cmd.

rem ---------------------------------------------------------------------
rem Upstream endpoint
rem ---------------------------------------------------------------------
rem OpenAI-compatible base URL. The proxy appends /chat/completions and
rem /models. Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1,
rem http://localhost:11434/v1
set "ASTER_OPENAI_BASE_URL=https://api.openai.com/v1"

rem Upstream API key (required). Sent as "Authorization: Bearer <key>".
set "ASTER_OPENAI_API_KEY=sk-REPLACE-ME"

rem Upstream model used for every alias that has no explicit mapping.
set "ASTER_OPENAI_MODEL=gpt-4o"

rem Optional JSON map: app model id -> upstream model id. The app keeps its
rem model-specific behaviour while the proxy routes to the mapped model.
rem set "ASTER_MODEL_MAP={"claude-opus-5":"gpt-4o","claude-sonnet-4-6":"gpt-4o-mini","claude-haiku-4-5":"gpt-4o-mini"}"

rem ---------------------------------------------------------------------
rem Local proxy (defaults shown)
rem ---------------------------------------------------------------------
rem rem set "ASTER_PROXY_PORT=8787"
rem rem set "ASTER_PROXY_HOST=127.0.0.1"
