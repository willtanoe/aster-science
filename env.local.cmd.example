@echo off
rem Copy this file to env.local.cmd and fill in your values.
rem env.local.cmd is gitignored; never commit real credentials.
rem Loaded by aster-science.cmd and proxy\run-proxy.cmd.
rem
rem MODEL ROUTING IN ONE PARAGRAPH
rem   The app asks for an alias (claude-opus-5, claude-sonnet-4-6,
rem   claude-haiku-4-5). Each alias resolves to a route: model + base URL +
rem   API key. ASTER_MODEL_MAP maps aliases to routes. If the map is non-empty
rem   its keys are the aliases shown to the app. Aliases without a map entry
rem   fall back to ASTER_OPENAI_MODEL on ASTER_OPENAI_BASE_URL with
rem   ASTER_OPENAI_API_KEY. A map value can be a string (reuse the default
rem   base/key) or an object {model, base_url?, api_key?} for another provider.

rem ---------------------------------------------------------------------
rem Default upstream (used by fallback and by string map entries)
rem ---------------------------------------------------------------------
set "ASTER_OPENAI_BASE_URL=https://api.openai.com/v1"
set "ASTER_OPENAI_API_KEY=sk-REPLACE-ME"
set "ASTER_OPENAI_MODEL=gpt-4o"

rem ---------------------------------------------------------------------
rem Scenario A — one upstream model for every alias
rem ---------------------------------------------------------------------
rem Leave ASTER_MODEL_MAP unset. The three default aliases are advertised and
rem all resolve to gpt-4o on the default endpoint.

rem ---------------------------------------------------------------------
rem Scenario B — three aliases, three models, same endpoint
rem ---------------------------------------------------------------------
rem set "ASTER_MODEL_MAP={"claude-opus-5":"gpt-4o","claude-sonnet-4-6":"gpt-4o-mini","claude-haiku-4-5":"o4-mini"}"

rem ---------------------------------------------------------------------
rem Scenario C — three aliases across different providers
rem ---------------------------------------------------------------------
rem set "ASTER_MODEL_MAP={"claude-opus-5":"gpt-4o","claude-sonnet-4-6":{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-deepseek"},"claude-haiku-4-5":{"model":"qwen-plus","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"sk-qwen"}}"

rem ---------------------------------------------------------------------
rem Scenario D — partial map (advertise only the mapped aliases)
rem ---------------------------------------------------------------------
rem set "ASTER_MODEL_MAP={"claude-opus-5":"gpt-4o"}"
rem Only claude-opus-5 is advertised. If the app still requests
rem claude-sonnet-4-6 / claude-haiku-4-5 internally, they use the fallback
rem ASTER_OPENAI_MODEL on the default endpoint.

rem ---------------------------------------------------------------------
rem Local proxy (defaults shown)
rem ---------------------------------------------------------------------
rem set "ASTER_PROXY_PORT=8787"
rem set "ASTER_PROXY_HOST=127.0.0.1"
